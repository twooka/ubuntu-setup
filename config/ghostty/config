# ── font
font-family = JetBrains Mono
font-size = 11
font-feature = -calt
adjust-cell-height = 10%

# ── colours: black + HUD greens
background = #000000
foreground = #9fdfb0
cursor-color = #00ff66
selection-background = #0b6e35
selection-foreground = #ffffff
palette = 0=#0a0a0a
palette = 1=#ff5f56
palette = 2=#00ff66
palette = 3=#ffb000
palette = 4=#5fafff
palette = 5=#c678dd
palette = 6=#56d6c9
palette = 7=#9fdfb0
palette = 8=#3a3a3a
palette = 9=#ff7b72
palette = 10=#7dffb0
palette = 11=#ffd166
palette = 12=#8cc8ff
palette = 13=#e0a3ff
palette = 14=#8af0e5
palette = 15=#e8fff0
minimum-contrast = 1.1
background-opacity = 0.92

# ── window
window-decoration = auto
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
gtk-single-instance = true
window-inherit-working-directory = true
confirm-close-surface = false
gtk-tabs-location = top

# ── cursor / mouse / clipboard
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 50000000

# ── splits
unfocused-split-opacity = 0.75
split-divider-color = #0b6e35

# ── shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── keybinds
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+e=equalize_splits
keybind = ctrl+shift+r=reload_config
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
window-theme = ghostty
gtk-wide-tabs = false
